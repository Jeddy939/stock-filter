rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function invitedUser() {
      return request.auth != null
        && request.auth.token.email in [
          "mrbowcock@gmail.com",
          "brady.bowcock@gmail.com",
          "damien.sundgren@gmail.com"
        ];
    }

    match /snapshots/{allPaths=**} {
      allow read: if invitedUser();
      allow write: if false;
    }

    // Raw SQLite checkpoints and exports are server-side artifacts. Cloud Run
    // uses its service account, which bypasses client Storage Rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
